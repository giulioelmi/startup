# ---- App ----
PUBLIC_URL=https://your-tunnel.trycloudflare.com   # public https URL (needed for Twilio/fax/email webhooks)
APP_PASSWORD=change-me                            # login for the web app (user: admin)
WEBHOOK_TOKEN=long-random-string                  # secret in inbound email/fax webhook URLs
DATABASE_URL=                                     # Postgres (set automatically by Vercel's Neon integration)
# DATA_DIR=./data                                 # local only: embedded Postgres folder when DATABASE_URL is empty

# ---- Sending hospital (defaults on the "start transfer" form) ----
SENDING_HOSPITAL_NAME="Pomona Community Hospital"
SENDING_HOSPITAL_PHONE=909-555-0100
SENDING_HOSPITAL_FAX=909-555-0101
SENDING_HOSPITAL_LAT=34.0551
SENDING_HOSPITAL_LNG=-117.7523

# ---- Epic FHIR sandbox (Backend Services app on fhir.epic.com) ----
EPIC_CLIENT_ID=
EPIC_PRIVATE_KEY=                                 # from: npm run epic:key
EPIC_KEY_ID=transfer-ai-1

# ---- AI model: google | anthropic | openai | ollama | any OpenAI-compatible name ----
LLM_PROVIDER=google
LLM_MODEL=gemini-flash-latest
LLM_API_KEY=
# LLM_FALLBACK_MODEL=gemini-flash-lite-latest   # used when the main model fails (default for google)
# LLM_BASE_URL=http://localhost:11434/v1         # ollama / OpenAI-compatible only

# ---- Phone calls (Twilio) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+1...
CALL_TEST_NUMBER=+1...                            # prefilled "number to call"; use YOUR phone while testing
# TWILIO_VOICE=Polly.Joanna-Neural

# ---- Fax: mock (default, nothing transmitted) | sinch ----
FAX_PROVIDER=mock
FAX_TEST_NUMBER=                                  # prefilled "fax to"; use your own fax while testing
SINCH_PROJECT_ID=
SINCH_KEY_ID=
SINCH_KEY_SECRET=
